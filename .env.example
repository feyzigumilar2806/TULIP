# ============================================================
# KONFIGURASI APLIKASI
# ============================================================

APP_NAME=TULIP
APP_ENV=development


# ============================================================
# KONFIGURASI DATABASE POSTGRESQL
# Ganti USERNAME dan PASSWORD sesuai server yang digunakan
# ============================================================

DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@localhost:5432/tulip


# ============================================================
# KONFIGURASI KEAMANAN
# Jangan menggunakan nilai contoh ini pada server produksi
# ============================================================

SECRET_KEY=GANTI_DENGAN_SECRET_KEY_YANG_PANJANG_DAN_ACAK
ACCESS_TOKEN_EXPIRE_MINUTES=480


# ============================================================
# KONFIGURASI FILE BUKTI
# ============================================================

MAX_FILE_SIZE_MB=5
UPLOAD_DIRECTORY=uploads